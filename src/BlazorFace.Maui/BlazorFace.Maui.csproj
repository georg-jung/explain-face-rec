<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Pin the Android API used to compile and package the app for Google Play. -->
    <TargetFrameworks>net10.0-android36.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) and '$(NoAndroid)' == 'TRUE'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) and '$(NoAndroid)' != 'TRUE'">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- Select one app target without overriding frameworks in referenced projects. -->
    <TargetFrameworks Condition="'$(MauiTargetFrameworks)' != ''">$(MauiTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>BlazorFace.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- Display name -->
    <ApplicationTitle>Understanding Face Recognition</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.gjung.blazorface.maui</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <Target Name="ConvertToMauiAsset" DependsOnTargets="ResolveProjectReferences" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <ContentToMauiAsset Include="@(Content)" Condition="'%(Extension)' == '.onnx'" />
      <MauiAsset Include="@(ContentToMauiAsset)" />
      <Content Remove="@(ContentToMauiAsset)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#fff" BaseSize="128,128" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#fff" ForegroundScale="0.8" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#fff" ForegroundScale="0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="FaceAiSharp.Bundle" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime">
      <!-- Android native libraries come from the package's AAR build target. Exclude
           NuGet's desktop native assets, which can otherwise replace the AAR's .so
           when publishing on Linux (https://github.com/microsoft/onnxruntime/issues/29270). -->
      <ExcludeAssets Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorFace\BlazorFace.csproj" />
  </ItemGroup>

  <Target Name="IncludeSharedLibmanAssetsAsMauiAssets" DependsOnTargets="ResolveProjectReferences" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_SharedLibmanAssets Include="..\BlazorFace\wwwroot\lib\**\*" />
      <MauiAsset Include="@(_SharedLibmanAssets)" LogicalName="wwwroot/lib/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Native dependencies must support Android devices with 16 KB memory pages. -->
    <WarningsAsErrors>$(WarningsAsErrors);XA0141</WarningsAsErrors>
    <AndroidPackageFormats Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormats>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(Configuration)' == 'Release' and '$(AndroidSigningKeyStore)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyAlias>key</AndroidSigningKeyAlias>
  </PropertyGroup>

</Project>
